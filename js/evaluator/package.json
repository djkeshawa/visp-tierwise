{
  "name": "@tierwise/evaluator",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Tierwise evaluator: resolve and decide over canonical bundles, in Node and browsers, with zero runtime dependencies",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tierwise/tierwise.git",
    "directory": "js/evaluator"
  },
  "homepage": "https://github.com/tierwise/tierwise/tree/main/js/evaluator#readme",
  "bugs": {
    "url": "https://github.com/tierwise/tierwise/issues"
  },
  "keywords": [
    "tierwise",
    "entitlements",
    "feature-flags",
    "tiers",
    "configuration",
    "evaluator",
    "bundle"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "tierwise": {
    "supportedSpecVersions": [
      "0.1"
    ],
    "supportedBundleFormatVersions": [
      "1"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/mark-cjs.mjs dist/cjs",
    "test": "node --test test/*.test.mjs"
  }
}
