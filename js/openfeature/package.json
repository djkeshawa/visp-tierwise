{
  "name": "@visplabs/openfeature",
  "version": "0.1.0",
  "description": "OpenFeature server and web providers backed by @visplabs/evaluator",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visplabs/tierwise.git",
    "directory": "js/openfeature"
  },
  "homepage": "https://github.com/visplabs/tierwise/tree/main/js/openfeature#readme",
  "bugs": {
    "url": "https://github.com/visplabs/tierwise/issues"
  },
  "keywords": [
    "tierwise",
    "entitlements",
    "feature-flags",
    "tiers",
    "configuration",
    "openfeature",
    "openfeature-provider"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "tierwise": {
    "supportedSpecVersions": [],
    "supportedBundleFormatVersions": []
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/mark-cjs.mjs dist/cjs",
    "typecheck": "tsc -p test/tsconfig.json",
    "test": "pnpm run typecheck && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@visplabs/evaluator": "workspace:*"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0",
    "@openfeature/core": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    },
    "@openfeature/web-sdk": {
      "optional": true
    }
  }
}
