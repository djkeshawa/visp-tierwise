{
  "name": "@visporg/node",
  "version": "0.1.0",
  "description": "Tierwise bundle loader for Node: fetch with ETag refresh, last-known-good and atomic swap",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visplabs/tierwise.git",
    "directory": "js/node"
  },
  "homepage": "https://github.com/visplabs/tierwise/tree/main/js/node#readme",
  "bugs": {
    "url": "https://github.com/visplabs/tierwise/issues"
  },
  "keywords": [
    "tierwise",
    "entitlements",
    "feature-flags",
    "tiers",
    "configuration",
    "node",
    "bundle"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "tierwise": {
    "supportedSpecVersions": [],
    "supportedBundleFormatVersions": []
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/mark-cjs.mjs dist/cjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@visporg/evaluator": "workspace:*"
  }
}
