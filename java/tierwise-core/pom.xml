<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.tierwise</groupId>
    <artifactId>tierwise-parent</artifactId>
    <version>0.1.0-dev.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>tierwise-core</artifactId>
  <packaging>jar</packaging>
  <name>Tierwise Core</name>
  <description>The Tierwise core library: loads, validates and compiles Tierwise projects into bundles, and evaluates bundles (resolve and decide) with no framework dependencies.</description>

  <dependencies>
    <!-- Runtime: the two dependencies of ADR 0012. -->
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <!-- Test: JUnit Jupiter (versions from the junit-bom import) and jqwik. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Hand-written resources of the module, if any. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The built-in presets of MANIFEST-21 are the files of the repository's presets/ directory. -->
      <resource>
        <directory>${project.basedir}/../../presets</directory>
        <includes>
          <include>*.yaml</include>
        </includes>
        <targetPath>io/github/tierwise/core/internal/project/presets</targetPath>
      </resource>
      <!-- The IANA zone and link names that an iana_tz value is checked against (TYPE-34). -->
      <resource>
        <directory>${project.basedir}/../../spec/data</directory>
        <includes>
          <include>tz-names.txt</include>
        </includes>
        <targetPath>io/github/tierwise/core/internal/check</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The spec conformance suite runs only with -Pconformance (see the parent POM). -->
          <excludedGroups>${tierwise.excludedGroups}</excludedGroups>
          <!-- Keep the jqwik database in the build directory, not as an untracked file in the module. -->
          <properties>
            <configurationParameters>jqwik.database=${project.build.directory}/jqwik-database</configurationParameters>
          </properties>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <!-- requirements §3.2: no Spring, no networking, no logging framework in core. -->
            <id>enforce-core-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                    <exclude>io.micrometer</exclude>
                    <exclude>org.slf4j</exclude>
                    <exclude>ch.qos.logback</exclude>
                    <exclude>org.apache.logging.log4j</exclude>
                    <exclude>commons-logging</exclude>
                    <exclude>com.squareup.okhttp3</exclude>
                    <exclude>org.apache.httpcomponents*</exclude>
                    <exclude>io.netty</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    <exclude>com.fasterxml.jackson.dataformat</exclude>
                    <exclude>org.yaml:snakeyaml</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
